+# --------------------------------------------------------------------------- KL disjoint (ablation K)
+def disjoint_kl_loss(
+    logp: "torch.Tensor",
+    ref_logp: "torch.Tensor",
+    mask: "torch.Tensor",
+    gamma: Optional["torch.Tensor"],
+    ce_weights: Optional["torch.Tensor"],
+    beta: float,
+) -> tuple["torch.Tensor", "torch.Tensor", "torch.Tensor", "torch.Tensor", "torch.Tensor"]:
+    r"""The off-domain KL anchor loss, DISJOINT per row (scout_task_plan.md 10.2).
+
+    ``LLaMA-Factory .../sft/trainer.py:_tw_kl_compute_loss`` normalises CE by the micro-batch's
+    WEIGHT SUM. With ``per_device_train_batch_size=1`` an "anchor" row whose CE weights are all some
+    epsilon has ``w.sum() = n*epsilon``, the epsilon cancels, and the row trains at full CE strength
+    -- the anchored adapter would silently become a pooled one (the exact regression
+    ``tests/test_kl_disjoint.py`` pins). This function instead classifies each ROW (sample) as CE-only
+    or KL-only from its own gamma:
+
+        row has ANY anchored token (gamma.sum(row) > 0)  ->  KL row: contributes KL only, no CE
+        row has none                                     ->  CE row: contributes CE only, no KL
+
+    A "row" is dimension 0 (one training example in the micro-batch), matching the plan's "an anchor
+    row" language: gamma is per-token but the row/CE-or-KL classification is per-sample.
+
+    Parameters
+    ----------
+    logp, ref_logp : (B, T) log p(target) under the student / the frozen reference, already causal
+        shifted (see ``CustomSeq2SeqTrainer._tw_target_logprobs``).
+    mask : (B, T) bool, the causal-shifted supervised-token mask (``shift_labels.ne(IGNORE_INDEX)``).
+    gamma : (B, T) float or None, the causal-shifted KL role mask (``kl_gamma[..., 1:]``). None is
+        treated as "no anchored token anywhere", i.e. every row is a CE row. It is unreachable in
+        practice: ``assert_disjoint_requires_gamma`` refuses to construct the trainer without a gamma
+        side-car, and the trainer raises if a batch then lacks the ``kl_gamma`` column.
+    ce_weights : (B, T) float or None, an optional per-token CE weight for the CE rows (None = uniform
+        CE, which is what K1 uses -- the dose lives in row COUNT via the corpus builder, not in a
+        per-token weight).
+    beta : the anchor coefficient (``TW_KL_BETA``).
+
+    Returns
+    -------
+    (loss, ce, kl_term, n_ce_rows, n_kl_rows)
+
+    ``ce`` is the mean CE over the CE rows' supervised tokens: a GRAPH-CONNECTED zero when there are
+    no CE rows in the micro-batch (an all-anchor batch), because the numerator is then exactly zero
+    and the denominator is clamped away from zero -- there is no branch, so ``ce`` stays
+    differentiable and on the right device/dtype even when it contributes nothing. ``kl_term`` is
+    ``sum(k3 * gamma) / sum(gamma)`` restricted to the KL rows, with the SAME clamp
+    ``_tw_kl_compute_loss`` already uses, zero (same graph-connected way) when there are no KL rows.
+    ``loss = ce + beta * kl_term``. ``n_ce_rows``/``n_kl_rows`` are per-micro-batch counts, for the
+    ``ce_rows=`` / ``kl_rows=`` step log.
+    """
+    import torch
+
+    mask_f = mask.float()
+    g = torch.zeros_like(mask_f) if gamma is None else (gamma.float() * mask_f)
+
+    is_kl_row = g.sum(dim=-1) > 0.0          # (B,) -- any anchored supervised token in this row
+    is_ce_row = ~is_kl_row
+    n_ce_rows = is_ce_row.sum()
+    n_kl_rows = is_kl_row.sum()
+
+    ce_mask = is_ce_row.unsqueeze(-1).float() * mask_f
+    w = ce_mask if ce_weights is None else (ce_weights.float() * ce_mask)
+    ce = -(logp * w).sum() / w.sum().clamp(min=1e-6)
+
+    d = (ref_logp - logp).clamp(-20.0, 8.0)
+    kl = torch.exp(d) - d - 1.0
+    # `g` is already 0 outside KL rows (gamma is expected to be 0 on CE-row tokens by construction
+    # of the side-car), but the KL-row mask is applied again here so a mis-built gamma side-car
+    # cannot leak a KL contribution through a row this function itself classified as CE.
+    kl_g = g * is_kl_row.unsqueeze(-1).float()
+    kl_term = (kl * kl_g).sum() / kl_g.sum().clamp(min=1e-6)
+
+    loss = ce + float(beta) * kl_term
+    return loss, ce, kl_term, n_ce_rows, n_kl_rows
+
+
