+def supervised_tail_start(labels, ignore_index: int = IGNORE_INDEX) -> int:
+    r"""Index of the first position whose LOGITS the loss needs, for a (B, T) label tensor.
+
+    The logits at position t predict token t+1, so a first supervised token at position f needs the
+    logits from f-1. Returned is ``max(min_over_rows(f) - 1, 0)``; keeping positions ``start..T-1``
+    (``logits_to_keep = T - start``) and cutting labels to ``labels[..., start:]`` leaves the usual
+    ``logits[..., :-1, :]`` / ``labels[..., 1:]`` shift aligned, and every supervised token keeps the
+    logits it had with the full sequence. A row with NO supervised token returns 0 (keep everything):
+    the conservative answer, and the caller's existing "no labels" errors still fire.
+    """
+    sup = labels.ne(ignore_index)
+    if sup.dim() == 1:
+        sup = sup.unsqueeze(0)
+    if not bool(sup.any(dim=-1).all()):
+        return 0
+    first = int(sup.float().argmax(dim=-1).min().item())
+    return max(first - 1, 0)
+
